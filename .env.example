# ==============================================================================
# MeetMind AI - Comprehensive Environment Variables Reference
# ==============================================================================
# This file documents all environment variables used across the three services:
# 1. AI Agent Service (Python Flask + Gunicorn)
# 2. Backend Service (Java Spring Boot + Docker)
# 3. Frontend Service (React + Vite Static Site)
#
# DO NOT COMMIT REAL SECRETS OR SENSITIVE PASSWORDS TO SOURCE CONTROL.
# Configure these variables securely in your Render dashboard or local .env file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI AGENT SERVICE (Python Flask / Gunicorn)
# Render Service Type: Web Service (Environment: Python 3)
# ------------------------------------------------------------------------------
# Required: Secret Groq API key for Llama 3.3 70B orchestrator and Whisper STT
# Obtain free API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional model overrides (defaults are optimal)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# Port binding (Render injects PORT automatically; defaults to 5001 locally)
PORT=5001
FLASK_PORT=5001
FLASK_DEBUG=False

# Allowed CORS origins for AI agent (can be "*" or comma-separated origins)
CORS_ALLOWED_ORIGINS=*

# Production Gunicorn start command (configured in Render Dashboard or render.yaml):
# gunicorn app:app --bind 0.0.0.0:$PORT --workers 2 --timeout 120


# ------------------------------------------------------------------------------
# 2. BACKEND SERVICE (Java Spring Boot)
# Render Service Type: Web Service (Environment: Docker)
# ------------------------------------------------------------------------------
# Port binding (Render injects PORT automatically; defaults to 8085 locally)
PORT=8085
SERVER_PORT=8085

# Database Connection:
# In Local Development:
# MONGODB_URI=mongodb://localhost:27017/meetmind_db
#
# In Production on Render (MongoDB Atlas Cluster):
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/meetmind_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://dbUser:yourStrongPassword@cluster0.abcde.mongodb.net/meetmind_db?retryWrites=true&w=majority
SPRING_DATA_MONGODB_URI=mongodb+srv://dbUser:yourStrongPassword@cluster0.abcde.mongodb.net/meetmind_db?retryWrites=true&w=majority

# AI Agent Service URL:
# Local: http://localhost:5001
# Render Production: Full URL of your deployed meetmind-ai-agent web service
MEETMIND_AI_AGENT_URL=https://meetmind-ai-agent.onrender.com
AI_AGENT_URL=https://meetmind-ai-agent.onrender.com

# Timeouts for communication with AI Agent (in milliseconds)
AI_AGENT_CONNECT_TIMEOUT_MS=10000
AI_AGENT_READ_TIMEOUT_MS=120000

# CORS Allowed Origins for Spring Boot (comma-separated):
# Must include your deployed frontend URL
# Local: http://localhost:5173,http://localhost:3000
# Production: https://meetmind-frontend.onrender.com
CORS_ALLOWED_ORIGINS=https://meetmind-frontend.onrender.com,http://localhost:5173


# ------------------------------------------------------------------------------
# 3. FRONTEND SERVICE (React + Vite)
# Render Service Type: Static Site
# ------------------------------------------------------------------------------
# In Local Development:
# Leave empty or set to /api (Vite proxy forwards /api to http://localhost:8085)
# VITE_API_BASE_URL=/api
#
# In Production on Render:
# Set to your deployed Spring Boot Web Service URL (with or without /api)
# Note: Vite injects this at build time, so trigger a redeploy if this URL changes.
VITE_API_BASE_URL=https://meetmind-backend.onrender.com
