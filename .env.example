# ==============================================================================
# MeetMind AI - Environment Variables Reference Configuration
# Copy this file to .env or configure relevant environment variables per service.
# ==============================================================================

# --- AI Agent Service (Python Flask - Port 5001) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3
FLASK_PORT=5001
FLASK_DEBUG=False

# --- Backend Service (Java Spring Boot - Port 8080) ---
SERVER_PORT=8080
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/meetmind_db
MEETMIND_AI_AGENT_URL=http://localhost:5001

# --- Frontend Service (React Vite - Port 5173) ---
# Proxies /api -> http://localhost:8080 by default in vite.config.js
VITE_API_BASE_URL=/api
