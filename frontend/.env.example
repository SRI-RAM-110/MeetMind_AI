# ==============================================================================
# MeetMind AI - Frontend Environment Variables
# ==============================================================================
# In local development, leave this empty or unset to use the Vite proxy (/api -> http://localhost:8085)
# In production on Render, set this to your deployed Spring Boot Web Service URL:
# Example: https://meetmind-backend.onrender.com (or https://meetmind-backend.onrender.com/api)
VITE_API_BASE_URL=
